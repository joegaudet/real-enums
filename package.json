{
  "name": "real-enums-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc --build --force && pnpm -r --filter './packages/*' run build",
    "typecheck": "tsc --build && pnpm typecheck:tools",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:examples": "pnpm -r --filter './examples/*' run test",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "release": "pnpm build && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "esbuild": "^0.27.7",
    "eslint": "^10.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
