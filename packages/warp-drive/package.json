{
  "name": "@real-enums/warp-drive",
  "version": "2.1.0",
  "description": "real-enums for WarpDrive and ember-data: one @attr(\"enum\") transform for every enum, and schema Transformations.",
  "keywords": [
    "ember-addon",
    "ember",
    "ember-data",
    "warp-drive",
    "enum"
  ],
  "license": "MIT",
  "author": "Joe Gaudet joe@joegaudet.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joegaudet/real-enums.git",
    "directory": "packages/warp-drive"
  },
  "homepage": "https://joegaudet.com/real-enums/",
  "bugs": "https://github.com/joegaudet/real-enums/issues",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./app/*": "./app/*",
    "./addon-main.cjs": "./addon-main.cjs"
  },
  "files": [
    "dist",
    "app",
    "addon-main.cjs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@real-enums/core": "workspace:^",
    "@warp-drive/core": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@real-enums/core": "workspace:^",
    "@warp-drive/core": "^5.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./transforms/enum.js": "./app/transforms/enum.js"
    }
  }
}
